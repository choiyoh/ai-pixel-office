{
  "name": "ai-pixel-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "tsx scripts/assets.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run assets && npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests server",
    "test": "tsx --test tests/*.test.ts",
    "start": "node server/app.mjs",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.2",
    "fastify": "5.8.5",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "26.0.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "pngjs": "7.0.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.2",
    "vite": "8.0.8"
  },
  "license": "MIT"
}
