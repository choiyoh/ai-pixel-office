{
  "name": "ai-pixel-office",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "tsx scripts/assets.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run assets && npm run typecheck && vite build && node scripts/build-worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests server platform",
    "test": "node scripts/tasks.mjs unit",
    "start": "node server/app.mjs",
    "test:browser": "node scripts/mock-browser.mjs",
    "setup": "node scripts/setup.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "test:integration": "node scripts/tasks.mjs integration",
    "hooks:plan": "node scripts/hooks-plan.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:upstream": "node scripts/test-upstream.mjs",
    "test:connection-browser": "node scripts/connection-browser.mjs",
    "test:live-browser": "node scripts/live-browser.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "check:source": "node scripts/check-source.mjs",
    "test:p2a4-browser": "node scripts/p2a4-browser.mjs",
    "doctor:command-code": "node scripts/command-code-doctor.mjs",
    "bridge:start": "node scripts/provider-bridge.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.2",
    "fastify": "5.8.5",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "26.0.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "pngjs": "7.0.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.2",
    "vite": "8.0.8",
    "esbuild": "0.28.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  }
}
